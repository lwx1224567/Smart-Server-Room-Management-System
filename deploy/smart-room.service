[Unit]
Description=Smart Server Room Management System
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smartroom
Group=smartroom
WorkingDirectory=/opt/smart-room/backend
EnvironmentFile=/etc/smart-room/backend.env
ExecStart=/usr/bin/java -jar /opt/smart-room/backend/smartpark-0.0.1-SNAPSHOT.jar
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
