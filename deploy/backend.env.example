# Copy outside the repository to /etc/smart-room/backend.env and replace values.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/smart_room_demo?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia%2FShanghai
DB_USERNAME=replace_with_database_user
DB_PASSWORD=replace_with_database_password
SPRING_PROFILES_ACTIVE=integrations
INTEGRATION_MODEL_KEY=replace_with_your_api_key
INTEGRATION_MODEL_NAME=deepseek-flash
INTEGRATION_MODEL_URL=https://api.deepseek.com/chat/completions
